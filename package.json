{
  "name": "changepoint-backend",
  "version": "1.0.0",
  "description": "多变量序列离线变点与最优分段后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "cli": "node --experimental-sqlite --import tsx src/cli.ts",
    "test": "node --experimental-sqlite --import tsx --test test/*.test.ts",
    "demo": "node --experimental-sqlite --import tsx scripts/demo.ts"
  },
  "keywords": [
    "changepoint",
    "segmentation",
    "dynamic-programming",
    "sqlite",
    "timeseries"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
